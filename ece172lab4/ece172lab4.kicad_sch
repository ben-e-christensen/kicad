		(uuid "2a36f1da-f866-4fdb-ae46-072935d2c302")
	)
	(text "Pins 1,2,3 set bits e.g. pins 1 and 3 toggled = 101\n\nPins 4 and 5 set to I/O0 and I/O1 respectively for easy setting when writing\n\nPin 6 sets (CE)' to HIGH when toggled\nPin 7 sets (OE)' to LOW when toggled\nPin 8 sets (WE)' to LOW when toggled\n"
		(exclude_from_sim no)
		(at 56.896 70.866 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5e0d2935-c197-4de0-b03e-dcf847278e0c")
	)
