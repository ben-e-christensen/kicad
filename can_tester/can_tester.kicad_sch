	)
	(text "This breakout board will\nbe for writing code to AVR\nMiddle pin should be 5V, but \nfuture proofing it for when we don't\nactually want that and AVR will get power elsewhere"
		(exclude_from_sim no)
		(at 234.188 43.434 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4d21579f-d79f-4d3b-b346-bfc9248d752b")
	)
	(text "Wiring to signify ID to scream\ninto CAN. Pull down. truth table\nin datasheet.\nWiring wonky to make the PCB layout smoother\n\n"
		(exclude_from_sim no)
		(at 140.462 121.158 0)
		(effects
			(font
				(size 1.27 1.27)
			)
