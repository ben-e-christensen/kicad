	(text "Electrometer - first stage is charge reading, second stage is for gain (unity or 10x based on header pins)\n2.5V on the non inverting input is to be able to run this off of one supply.\nIt gives us a 2.5V offset, so the input can now swing -2.5 (to GND) and +2.5 (to V+)\n"
		(exclude_from_sim no)
		(at 69.596 173.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "20c50acc-3555-4b85-bf0e-51336cc48da3")
	)
	(text "Filtering circuit to give as clean of rails as possible to the Op Amp"
		(exclude_from_sim no)
		(at 52.578 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c7d41a02-f033-4d3f-93e6-f6792e768b23")
	)
	(text "Power coming in from main power board\nV- is Earth GND\nGND is Virtual GND (~1.66V relative to Earth GND)\nV+ is the 5V (relative to VGND) from the TPS61023\n"
		(exclude_from_sim no)
		(at 51.816 98.806 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d48a3d53-1447-44c8-b912-3858a1f351bb")
	)
